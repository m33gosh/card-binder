# Copy to .env.local for local development. All of these are safe to expose in
# the browser: Supabase's anon key is public by design (row security protects
# the data) and the Pokémon TCG key only raises your rate limit.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_POKEMONTCG_API_KEY=
# Path the app is served from. GitHub Pages project sites use /<repo-name>/.
VITE_BASE_PATH=/
SUPABASE_SERVICE_ROLE_KEY=
